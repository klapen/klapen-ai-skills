diff --git a/tests/test_cache_through.py b/tests/test_cache_through.py
new file mode 100644
index 0000000..2c9e6b4
--- /dev/null
+++ b/tests/test_cache_through.py
@@ -0,0 +1,18 @@
+import pytest
+
+
+async def test_cache_hit_returns_without_db(cache, repo_spy):
+    await cache.redis.set("widget:w-1:v1", b'{"id":"w-1"}')
+    result = await cache.get("w-1")
+    assert repo_spy.get.await_count == 0
+
+
+async def test_cache_miss_populates_ttl_from_config(cache, redis_spy):
+    await cache.set("w-1", {"id": "w-1"}, ttl=300)
+    assert redis_spy.set.call_args.kwargs["ex"] == 300
+
+
+async def test_redis_down_falls_through_to_lru(cache, broken_redis):
+    assert await cache.get("w-1") == LRU_SENTINEL
+
+
+async def test_corrupt_cache_evicts_and_returns_none(cache, redis):
+    await redis.set("widget:w-1:v1", b"{not json")
+    assert await cache.get("w-1") is None
