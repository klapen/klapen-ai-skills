new file mode 100644
index 0000000..8a1f9c2
--- /dev/null
+++ b/services/widgets/cache.py
@@ -0,0 +1,24 @@
+from redis.asyncio import Redis
+from redis.exceptions import ConnectionError as RedisConnectionError
+from pydantic import ValidationError
+
+from .models import Widget
+from .lru import LRUCache
+
+
+class CacheThroughMiddleware:
+    def __init__(self, redis: Redis, lru: LRUCache, schema_version: str) -> None:
+        self.redis = redis
+        self.lru = lru
+        self.schema_version = schema_version
+
+    async def get(self, widget_id: str) -> Widget | None:
+        key = f"widget:{widget_id}:{self.schema_version}"
+        try:
+            raw = await self.redis.get(key)
+        except RedisConnectionError:
+            return self.lru.get(key)   # fail-open: latency-only degradation
+        if raw is None:
+            return None
+        try:
+            return Widget.model_validate_json(raw)
+        except ValidationError:
+            await self.redis.delete(key)
+            return None
